Algoritmo sin_titulo
	definir nota1, nota2, nota3, n3 Como Real
	Escribir "ingresar la nota1 del primer corte (25%)"
	Leer nota1;
	escribir "ingresar la nota del segundo corte (35%)"
	leer nota2;
	escribir "ingresar la nota del tercer corte (40%)"
	leer nota3;
	n3 <- (nota1*0.25)+(nota2*0.35)+(nota3*0.40);
	Escribir "la nota definitiva del estudiante es:", n3 
	
	
	
FinAlgoritmo
